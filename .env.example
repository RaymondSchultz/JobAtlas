POSTGRES_DB=jobatlas
POSTGRES_USER=jobatlas
POSTGRES_PASSWORD=jobatlas_dev_password
POSTGRES_PORT=5432

BACKEND_PORT=4000
NODE_ENV=development
JWT_SECRET=dev-only-jwt-secret
INTERNAL_SERVICE_KEY=dev-internal-service-key

MEILISEARCH_URL=http://meilisearch:7700
MEILI_MASTER_KEY=dev-meili-master-key

# Job ingestion (replaces the n8n schedule triggers).
# Connectors run in-process; leave false to disable all scheduled fetching.
INGESTION_ENABLED=false
EXPIRY_CRON=0 2 * * *
EXPIRE_AFTER_DAYS=30

# Adzuna (optional). Without both keys the connector is skipped automatically,
# so leaving these unset is safe. Register at https://developer.adzuna.com/
#
# Budget: the free tier allows ~1000 calls/month and one call returns at most
# 50 jobs. Each run costs (countries x ADZUNA_MAX_PAGES) calls, and the daily
# cron makes the defaults below ~570 calls/month. Raising ADZUNA_MAX_PAGES
# multiplies that directly, so check it against the quota before increasing it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=at,au,be,br,ca,ch,de,es,fr,gb,in,it,mx,nl,nz,pl,sg,us,za
ADZUNA_MAX_PAGES=1

# Connector page depth per run for the keyless sources.
THEMUSE_MAX_PAGES=10
ARBEITNOW_MAX_PAGES=3
