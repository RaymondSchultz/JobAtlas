{
  "name": "AI/Resume Processing",
  "nodes": [
    {
      "parameters": {
        "path": "jobatlas/resume-processing",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "id": "resume-webhook",
      "name": "Resume Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$json.fileUrl}}",
        "sendHeaders": false,
        "sendBody": false,
        "options": {
          "timeout": 60000
        },
        "retryOnFail": true,
        "maxTries": 5,
        "waitBetweenTries": 30000
      },
      "id": "fetch-resume-file",
      "name": "Fetch Resume File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        280,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INTERNAL_API_BASE_URL || 'https://internal.jobatlas.io/api/v1'}}/internal/ai/resume/parse",
        "sendHeaders": true,
        "sendBody": true,
        "options": {
          "timeout": 60000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{$env.INTERNAL_SERVICE_KEY}}"
            }
          ]
        },
        "contentType": "json",
        "jsonBody": "={{ { resumeId: $json.resumeId, fileContent: $binary || $json } }}",
        "retryOnFail": true,
        "maxTries": 5,
        "waitBetweenTries": 30000
      },
      "id": "parse-resume-via-ai-api",
      "name": "Parse Resume via AI API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INTERNAL_API_BASE_URL || 'https://internal.jobatlas.io/api/v1'}}/internal/ai/matching/run",
        "sendHeaders": true,
        "sendBody": true,
        "options": {
          "timeout": 60000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{$env.INTERNAL_SERVICE_KEY}}"
            }
          ]
        },
        "contentType": "json",
        "jsonBody": "={{ { resumeId: $json.resumeId } }}",
        "retryOnFail": true,
        "maxTries": 5,
        "waitBetweenTries": 30000
      },
      "id": "trigger-ai-matching",
      "name": "Trigger AI Matching",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        840,
        0
      ]
    }
  ],
  "connections": {
    "Resume Webhook": {
      "main": [
        [
          {
            "node": "Fetch Resume File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Resume File": {
      "main": [
        [
          {
            "node": "Parse Resume via AI API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Resume via AI API": {
      "main": [
        [
          {
            "node": "Trigger AI Matching",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 1800,
    "saveExecutionProgress": true
  },
  "active": false
}
