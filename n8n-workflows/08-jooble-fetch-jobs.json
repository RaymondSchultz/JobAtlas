{
  "name": "Jobs/Jooble/Fetch Jobs",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{'https://jooble.org/api/' + ($env.JOOBLE_API_KEY || '')}}",
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "{\"keywords\": \"Software Engineer\", \"location\": \"Remote\", \"page\": \"1\"}",
        "options": {
          "timeout": 60000
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 10000
      },
      "id": "fetch-jooble-jobs",
      "name": "Fetch Jooble Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [240, 0]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"source\": \"jooble\", \"fetchedAt\": \"={{$now.toISO()}}\", \"raw\": \"={{$json.jobs || []}}\"}",
        "options": {}
      },
      "id": "build-processor-envelope",
      "name": "Build Processor Envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INTERNAL_API_BASE_URL || 'https://internal.jobatlas.io/api/v1'}}/internal/jobs",
        "sendHeaders": true,
        "sendBody": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Service-Key",
              "value": "={{$env.INTERNAL_SERVICE_KEY}}"
            }
          ]
        },
        "contentType": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "post-internal-jobs",
      "name": "POST Internal Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [[{"node": "Fetch Jooble Jobs", "type": "main", "index": 0}]]
    },
    "Fetch Jooble Jobs": {
      "main": [[{"node": "Build Processor Envelope", "type": "main", "index": 0}]]
    },
    "Build Processor Envelope": {
      "main": [[{"node": "POST Internal Jobs", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionTimeout": 900,
    "saveExecutionProgress": true
  },
  "active": false
}
