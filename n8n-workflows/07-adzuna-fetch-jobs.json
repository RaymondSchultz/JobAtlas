{
  "name": "Jobs/Adzuna/Fetch Jobs",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/30 * * * *"
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{'https://api.adzuna.com/v1/api/jobs/us/search/1?app_id=' + ($env.ADZUNA_APP_ID || '') + '&app_key=' + ($env.ADZUNA_APP_KEY || '') + '&results_per_page=50&content-type=application/json'}}",
        "options": {
          "timeout": 60000
        },
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 10000
      },
      "id": "fetch-adzuna-jobs",
      "name": "Fetch Adzuna Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [240, 0]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\"source\": \"adzuna\", \"fetchedAt\": \"={{$now.toISO()}}\", \"raw\": \"={{$json.results || []}}\"}",
        "options": {}
      },
      "id": "build-processor-envelope",
      "name": "Build Processor Envelope",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INTERNAL_API_BASE_URL || 'https://internal.jobatlas.io/api/v1'}}/internal/jobs",
        "sendHeaders": true,
        "sendBody": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Service-Key",
              "value": "={{$env.INTERNAL_SERVICE_KEY}}"
            }
          ]
        },
        "contentType": "json",
        "jsonBody": "={{$json}}"
      },
      "id": "post-internal-jobs",
      "name": "POST Internal Jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [720, 0]
    }
  ],
  "connections": {
    "Schedule": {
      "main": [[{"node": "Fetch Adzuna Jobs", "type": "main", "index": 0}]]
    },
    "Fetch Adzuna Jobs": {
      "main": [[{"node": "Build Processor Envelope", "type": "main", "index": 0}]]
    },
    "Build Processor Envelope": {
      "main": [[{"node": "POST Internal Jobs", "type": "main", "index": 0}]]
    }
  },
  "settings": {
    "executionTimeout": 900,
    "saveExecutionProgress": true
  },
  "active": false
}
