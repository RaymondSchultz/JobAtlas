{
  "name": "Notifications/Job Alerts",
  "nodes": [
    {
      "parameters": {
        "path": "jobatlas/job-alerts/instant",
        "httpMethod": "POST",
        "responseMode": "lastNode"
      },
      "id": "instant-alert-webhook",
      "name": "Instant Alert Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        0,
        -120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "daily-digest-schedule",
      "name": "Daily Digest Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        80
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "weekly-digest-schedule",
      "name": "Weekly Digest Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        0,
        280
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.INTERNAL_API_BASE_URL || 'https://internal.jobatlas.io/api/v1'}}/internal/alerts/match",
        "sendHeaders": true,
        "sendBody": true,
        "options": {
          "timeout": 60000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Service-Key",
              "value": "={{$env.INTERNAL_SERVICE_KEY}}"
            }
          ]
        },
        "contentType": "json",
        "jsonBody": "={{$json}}",
        "retryOnFail": true,
        "maxTries": 5,
        "waitBetweenTries": 30000
      },
      "id": "find-matching-alerts",
      "name": "Find Matching Alerts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        320,
        80
      ]
    },
    {
      "parameters": {
        "workflowId": "Notifications/Email Alerts",
        "options": {}
      },
      "id": "dispatch-notifications",
      "name": "Dispatch Notifications",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1,
      "position": [
        640,
        80
      ]
    }
  ],
  "connections": {
    "Instant Alert Webhook": {
      "main": [
        [
          {
            "node": "Find Matching Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Daily Digest Schedule": {
      "main": [
        [
          {
            "node": "Find Matching Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Weekly Digest Schedule": {
      "main": [
        [
          {
            "node": "Find Matching Alerts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Matching Alerts": {
      "main": [
        [
          {
            "node": "Dispatch Notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionTimeout": 900,
    "saveExecutionProgress": true
  },
  "active": false
}
